# ============================================================
# 🧱 Node / Vite / React Project Git Ignore
# ============================================================

# Dependencies
node_modules/

# Build outputs
dist/
dist-ssr/
build/
coverage/
*.cache
.vite/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local environment files (do NOT commit secrets)
.env
.env.*
!.env.example     # keep the safe template

# Local IDE / OS junk
.DS_Store
Thumbs.db

# VSCode
.vscode/*
!.vscode/extensions.json  # keep recommended extensions only

# JetBrains IDEs
.idea/

# Windows junk
*.lnk

# Misc editors
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
